      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="运行时登录压测用户（JWT 仅驻留 JVM 内存）" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import groovy.json.JsonOutput
import groovy.json.JsonSlurper
import java.net.URI
import java.net.http.HttpClient
import java.net.http.HttpRequest
import java.net.http.HttpResponse
import java.time.Duration
import java.util.Collections
import java.util.concurrent.Executors
import java.util.concurrent.atomic.AtomicLong

int userCount = Integer.parseInt(vars.get('user_count'))
String phonePrefix = vars.get('user_phone_prefix')
int phoneWidth = Integer.parseInt(vars.get('user_phone_width'))
String password = vars.get('user_password')
int parallelism = Integer.parseInt(vars.get('login_parallelism'))
String baseUrl = vars.get('base_url')

if (userCount &lt; 1) {
    throw new IllegalArgumentException('user_count must be positive')
}
if (parallelism &lt; 1) {
    throw new IllegalArgumentException('login_parallelism must be positive')
}
if (password == null || password.isEmpty()) {
    throw new IllegalArgumentException('user_password is required')
}

String[] tokens = new String[userCount]
def errors = Collections.synchronizedList(new ArrayList&lt;String&gt;())
def client = HttpClient.newBuilder()
        .connectTimeout(Duration.ofSeconds(5))
        .build()
def pool = Executors.newFixedThreadPool(parallelism)
def futures = []

try {
    (1..userCount).each { int n -&gt;
        futures &lt;&lt; pool.submit({
            String phone = phonePrefix + n.toString().padLeft(phoneWidth, '0')
            String body = JsonOutput.toJson([phone: phone, password: password])
            def request = HttpRequest.newBuilder()
                    .uri(URI.create(baseUrl + '/api/auth/login'))
                    .timeout(Duration.ofSeconds(10))
                    .header('Content-Type', 'application/json')
                    .POST(HttpRequest.BodyPublishers.ofString(body))
                    .build()
            def response = client.send(request, HttpResponse.BodyHandlers.ofString())
            def parsed = new JsonSlurper().parseText(response.body())
            def token = parsed?.data?.token
            if (response.statusCode() != 200 || parsed?.code?.toString() != '200' || token == null || token.toString().isEmpty()) {
                throw new IllegalStateException('login failed for user index=' + n + ', http=' + response.statusCode() + ', code=' + parsed?.code)
            }
            tokens[n - 1] = token.toString()
            return null
        } as java.util.concurrent.Callable)
    }

    futures.each { future -&gt;
        try {
            future.get()
        } catch (Exception e) {
            def cause = e.getCause() ?: e
            errors.add(cause.getMessage() ?: cause.toString())
        }
    }
} finally {
    pool.shutdownNow()
}

if (!errors.isEmpty()) {
    throw new IllegalStateException('runtime login failed: count=' + errors.size() + ', first=' + errors.get(0))
}
if (tokens.any { it == null || it.isEmpty() }) {
    throw new IllegalStateException('runtime login token pool is incomplete')
}

props.put('mockDamaiRuntimeAuthTokens', tokens)
props.put('mockDamaiRuntimeAuthCursor', new AtomicLong(0L))
log.info('Runtime auth token pool ready: userCount={}', userCount)</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="仅 do_prewarm=true 时执行" enabled="true">
