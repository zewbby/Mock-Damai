            <hashTree/>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="提取处理状态" enabled="false">
              <stringProp name="JSONPostProcessor.referenceNames">orderRequestStatus;orderId;failReason</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.data.status;$.data.orderId;$.data.failReason</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1;1;1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">UNKNOWN;;</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Groovy 提取处理状态" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script">def body = prev.getResponseDataAsString()
try {
    def json = new groovy.json.JsonSlurper().parseText(body)
    def data = json.data ?: [:]
    vars.put(&apos;orderRequestStatus&apos;, data.status == null ? &apos;UNKNOWN&apos; : data.status.toString())
    vars.put(&apos;orderId&apos;, data.orderId == null ? &apos;&apos; : data.orderId.toString())
    vars.put(&apos;failReason&apos;, data.failReason == null ? &apos;&apos; : data.failReason.toString())
} catch (Exception ignored) {
    vars.put(&apos;orderRequestStatus&apos;, &apos;UNKNOWN&apos;)
    vars.put(&apos;orderId&apos;, &apos;&apos;)
    vars.put(&apos;failReason&apos;, &apos;响应不是合法JSON: &apos; + body)
}</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
            </JSR223PostProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="判断是否终态" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script">int count = (vars.getObject(&apos;pollCount&apos;) ?: 0) as int
vars.putObject(&apos;pollCount&apos;, count + 1)
def status = vars.get(&apos;orderRequestStatus&apos;)
def terminal = [&apos;SUCCESS&apos;, &apos;FAILED&apos;, &apos;COMPENSATED&apos;, &apos;CANCELLED&apos;]
if (terminal.contains(status)) {
    vars.putObject(&apos;pollDone&apos;, true)
}
if (status == &apos;FAILED&apos; || status == &apos;COMPENSATED&apos; || status == &apos;CANCELLED&apos;) {
    prev.setSuccessful(false)
    prev.setResponseMessage(&apos;订单请求进入失败终态：&apos; + status + &apos;, failReason=&apos; + (vars.get(&apos;failReason&apos;) ?: &apos;&apos;))
}</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
