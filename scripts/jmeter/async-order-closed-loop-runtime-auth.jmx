  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Mock-Damai 异步下单 Closed-Loop Preflight（Runtime Auth）">
      <stringProp name="TestPlan.comments">Closed-loop Preflight Runtime Auth：压测用户先在 setUp 阶段并发登录，JWT 只驻留 JMeter JVM 内存，不写 CSV；主压测线程按请求轮换内存 Token。线程数决定并发，不设置目标 QPS；用于估算容量数量级，不进入正式 Benchmark。结果轮询关闭。</stringProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
